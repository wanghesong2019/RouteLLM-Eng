# RouteLLM 部署环境变量示例
#
# 用法：
#   cp .env.example .env
#   编辑 .env 填入实际值
#   docker compose up -d
#
# 注意：.env 含密钥，已在 .gitignore 中排除，请勿提交。

# ---- 下游 LLM provider（OpenAI 兼容）--------------------------------------
# 模型名**必须**带 provider 前缀，如 openai/qwen3.7-max
# 裸模型名会触发 litellm BadRequestError（见 docs/CHANGELOG.md 问题6）
ROUTELLM_STRONG_MODEL=openai/qwen3.7-max
ROUTELLM_WEAK_MODEL=openai/qwen3.5-flash
ROUTELLM_API_BASE=https://taisure.com/v1
# 填入实际的下游 API key（taisure key 形如 sk-xxxx）
ROUTELLM_API_KEY=replace-me

# ---- 路由模型推理服务（host 侧）-------------------------------------------
# 容器经 host.docker.internal 访问 host 上的推理服务
# 启动推理服务见 services/README.md
ROUTELLM_INFERENCE_URL=http://host.docker.internal:6070

# ---- 启用的路由器 ---------------------------------------------------------
# remote_bert  : 走 host 推理服务（推荐，容器内无需 GPU）
# random       : 纯随机，用于连通性测试
# bert         : 进程内加载模型（需要容器内有模型权重 + GPU，不推荐）
# sw_ranking   : 相似度加权 Elo（需要 OpenAI Embedding + 下载 arena 数据集）
# mf           : 矩阵分解（同上）
ROUTELLM_ROUTERS=remote_bert

# ---- 服务端口 -------------------------------------------------------------
# 端口在 docker-compose.yml 中固定为 127.0.0.1:6060:6060
# ROUTELLM_PORT=6060
